# Note: Later versions of these components may break the build due to C++ being included in headers
ARG UBUNTU_VERSION=22.04
ARG UBUNTU_CODENAME=jammy
ARG UBUNTU_COMPONENT=unified
ARG GO_VERSION=1.24.2
ARG XPU_SMI_TAG=V1.3.1

########################################
# Base: Setup and install all components shared by following layers
########################################
FROM ubuntu:${UBUNTU_VERSION} AS base
ARG UBUNTU_VERSION
ARG UBUNTU_CODENAME
ARG UBUNTU_COMPONENT
ARG XPU_SMI_TAG
ARG GO_VERSION

ENV DEBIAN_FRONTEND=noninteractive

# Setup Intel GPU repository
RUN set -eux; \
    apt-get update && apt-get install -y --no-install-recommends ca-certificates gnupg2 wget; \
    wget -qO - https://repositories.intel.com/gpu/intel-graphics.key \
        | gpg --dearmor -o /usr/share/keyrings/intel-graphics.gpg; \
    echo "deb [arch=amd64 signed-by=/usr/share/keyrings/intel-graphics.gpg] https://repositories.intel.com/gpu/ubuntu ${UBUNTU_CODENAME} ${UBUNTU_COMPONENT}" \
        | tee /etc/apt/sources.list.d/intel-gpu-${UBUNTU_CODENAME}.list; \
    apt-get update; \
    rm -rf /var/lib/apt/lists/*

# Install Intel packages from repository (shared by build and final stages)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libze-intel-gpu1 libigsc0 libze1 && \
    rm -rf /var/lib/apt/lists/*

########################################
# Build: Install build-specific components and build everything needed for final stage
########################################
FROM base AS build
ARG UBUNTU_VERSION
ARG XPU_SMI_TAG
ARG GO_VERSION

# Install build dependencies
RUN apt-get update && apt-get install -y \
    git gcc make curl jq \
    && rm -rf /var/lib/apt/lists/*

# Install xpu-smi (ignore intel-gsc dependency as only libigsc0 is needed)
RUN set -eux; \
    API_URL="https://api.github.com/repos/intel/xpumanager/releases/tags/${XPU_SMI_TAG}"; \
    XPU_URL="$(curl -fsSL "$API_URL" \
      | jq -r '.assets[].browser_download_url | select(test("xpu-smi_.*u'${UBUNTU_VERSION}'_amd64\\.deb$"))' \
      | head -n1)"; \
    test -n "$XPU_URL"; \
    echo "Using xpu-smi from ${XPU_SMI_TAG}: ${XPU_URL}"; \
    curl -fsSL -o /tmp/xpu-smi.deb "$XPU_URL"; \
    dpkg -i --ignore-depends=intel-gsc /tmp/xpu-smi.deb; \
    rm -f /tmp/xpu-smi.deb

# Install Go
# Note: Distro packages are too old and there is no Ubuntu variant of Go base images
RUN curl -fsSL https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz \
    | tar -xzC /usr/local && \
    ln -s /usr/local/go/bin/go /usr/local/bin/go && \
    ln -s /usr/local/go/bin/gofmt /usr/local/bin/gofmt

# Build goxpusmi
WORKDIR /build
COPY . .

RUN export PATH="/usr/local/go/bin:$PATH" CGO_ENABLED=1 \
    && make vendor \
    && make bin/goxpusmi \
    && mkdir -p /install_root/bin \
    && cp bin/goxpusmi /install_root/bin/

# Copy xpu-smi license (Intel packages are already in base with their licenses)
RUN set -eux; \
    mkdir -p /install_root/licenses/xpu-smi; \
    if [ -f "/usr/share/doc/xpu-smi/copyright" ]; then \
      cp "/usr/share/doc/xpu-smi/copyright" "/install_root/licenses/xpu-smi/"; \
    fi; \
    make licenses && cp -r licenses /install_root/licenses-src

# Create image-versions.txt in build stage where all packages are installed
RUN set -eux; \
    { \
      echo "Image versions:"; \
      echo "  XPU-SMI (tag): ${XPU_SMI_TAG}"; \
      echo "  Ubuntu version: ${UBUNTU_VERSION}"; \
      echo "  Go: ${GO_VERSION}"; \
      echo "Installed packages:"; \
      dpkg-query -W -f='  ${Package}=${Version}\n' xpu-smi libze-intel-gpu1 libze1 libigsc0 2>/dev/null; \
    } | tee /install_root/image-versions.txt

########################################
# Final: Install final stage specific components
########################################
FROM base
ARG GO_VERSION
ARG XPU_SMI_TAG
ARG UBUNTU_VERSION
ARG UBUNTU_CODENAME
ARG UBUNTU_COMPONENT

LABEL xpu_smi.tag="${XPU_SMI_TAG}" \
      ubuntu.version="${UBUNTU_VERSION}" \
      go.version="${GO_VERSION}" \
      ze.repo="intel ${UBUNTU_CODENAME} ${UBUNTU_COMPONENT}" \
      description="Intel Go xpu-smi tool with libigsc and xpu-smi"

# ZE env var is specific to Level Zero GPU backend
ENV ZE_ENABLE_PCI_ID_DEVICE_ORDER=1

# Install runtime-only dependencies
# Note: hwloc is a dependency of libxpum (xpu-smi functionality)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libnuma1 libpciaccess0 libudev1 libdrm2 \
    libjson-c5 libelf1 libzstd1 hwloc libstdc++6 \
    && rm -rf /var/lib/apt/lists/*

# Copy binaries and libraries from build stage
COPY --from=build /usr/bin/xpu-smi /usr/bin/xpu-smi
COPY --from=build /usr/lib/x86_64-linux-gnu/libxpum.so.1 /usr/lib/x86_64-linux-gnu/libxpum.so.1
COPY --from=build /install_root/bin/goxpusmi /usr/local/bin/goxpusmi
COPY --from=build /install_root/licenses /licenses
COPY --from=build /install_root/image-versions.txt /etc/image-versions.txt

RUN ldconfig

ENTRYPOINT ["/usr/local/bin/goxpusmi"]
